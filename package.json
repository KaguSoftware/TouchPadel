{
  "name": "touchpadel",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:start": "pnpm --filter @touch/db db:start",
    "db:stop": "pnpm --filter @touch/db db:stop",
    "db:reset": "pnpm --filter @touch/db db:reset",
    "db:types": "pnpm --filter @touch/db db:types",
    "db:fixtures": "pnpm --filter @touch/db db:fixtures",
    "db:clear-dev-till": "pnpm --filter @touch/db db:clear-dev-till",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "security:env-names": "node scripts/security/check-public-env-names.mjs",
    "security:history": "node scripts/security/check-history-secrets.mjs",
    "security:artifacts": "node scripts/security/check-artifact-secrets.mjs",
    "security:audit": "node scripts/security/check-dependency-audit.mjs",
    "security": "pnpm security:env-names && pnpm security:history && pnpm security:data && pnpm security:web && pnpm security:audit",
    "security:data": "node scripts/security/check-data-hygiene.mjs",
    "security:web": "node scripts/security/check-web-security.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.47.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "19.1.10",
      "@types/react-dom": "19.1.9"
    }
  }
}
