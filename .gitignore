# Dependencies
node_modules/
.pnpm-store/

# Env & secrets — never commit
.env
.env.*
!.env.example
station.json
*.pem
# EXCEPT the EAS Update code-signing CERTIFICATE, which is the public half and
# has to ship inside the app binary to be any use (SEC-23). The matching PRIVATE
# key stays out — it is what proves an update is genuine, and it belongs in the
# password manager and EAS secrets, never here.
!apps/mobile/certs/certificate.pem
*.p12
*.keystore

# Build output
dist/
build/
.next/
.turbo/
.expo/
out/
release/
*.tsbuildinfo

# Supabase local state (any location)
**/supabase/.branches/
**/supabase/.temp/
/supabase/

# PDFs stay local-only everywhere (owner decision 2026-08-24) — the brand decks
# are far over GitHub's limits and the scope PDFs live on as .txt extracts in
# docs/scope/. Share originals out-of-band.
*.pdf

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs & coverage
*.log
coverage/
playwright-report/
test-results/

# Expo export output
apps/mobile/dist/

# Guard: never run `eas`/`expo` from the repo root — a stray root app.json/eas.json
# (wrong android package, no env) came from that on 2026-09-01. The real ones live
# in apps/mobile/. Root-anchored: does not affect apps/mobile/eas.json.
/app.json
/eas.json
