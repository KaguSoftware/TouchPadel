{
  "name": "@touch/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "EN/AR message catalogs, typed t() helper, Intl formatting (IQD, Asia/Baghdad), bidi/RTL helpers.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
