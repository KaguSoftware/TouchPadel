# Copy to packages/db/.env. Names only — never commit values.
# Loaded by dotenv for the DB tests and scripts (tests/helpers.ts, scripts/qr-artwork.mjs).
# Tests default to the local Docker stack (127.0.0.1:54321) when these are unset.
# Never point a destructive suite at the client's hosted project.
#
# LEAVE THESE THREE COMMENTED OUT unless you mean to override the local stack.
# dotenv sets an EMPTY string for `NAME=`, and tests/helpers.ts uses `??`, which
# keeps an empty string: SUPABASE_URL then becomes "", stackAvailable() answers
# false, and every stack-dependent suite skips itself quietly (found 2026-09-21).

# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never under a NEXT_PUBLIC_/EXPO_PUBLIC_/VITE_ name.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional. Postgres connection string for db-fixtures / db-menu; otherwise the
# scripts exec into the local Supabase container (SUPABASE_DB_CONTAINER).
DATABASE_URL=

# Local only: the code GoTrue accepts for the [auth.sms.test_otp] number in
# supabase/config.toml. Any six digits except 123456 — NOT the hosted
# store-review pair, which is generated fresh per review.
# `pnpm db:start` refuses to start without it (scripts/check-config-env.mjs).
SUPABASE_AUTH_SMS_TEST_OTP_CODE=
