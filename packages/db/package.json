{
  "name": "@touch/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public,app > src/types.gen.ts",
    "gen:types": "supabase gen types typescript --local --schema public,app > src/types.gen.ts",
    "db:fixtures": "node scripts/db-fixtures.mjs",
    "db:menu": "node scripts/db-menu.mjs",
    "db:client": "node scripts/db-client.mjs",
    "db:placeholders": "node scripts/make-placeholders.mjs",
    "db:clear-dev-till": "node scripts/clear-dev-till.mjs",
    "qr:artwork": "node scripts/qr-artwork.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:concurrency": "vitest run tests/concurrency.test.ts",
    "check:locks": "node scripts/check-lock-order.mjs",
    "check:authz": "node scripts/check-rpc-authz.mjs",
    "check:safeupdate": "node scripts/check-safe-update.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:invariants": "node scripts/check-db-invariants.mjs",
    "check:rpc-registry": "node scripts/check-rpc-registry.mjs",
    "check:broadcast": "node scripts/check-broadcast-payloads.mjs",
    "check:analytics": "node scripts/check-analytics-payload.mjs",
    "check:assistant-coverage": "node scripts/check-assistant-coverage.mjs",
    "assistant:map": "node scripts/build-assistant-map.mjs",
    "assistant:measure": "node scripts/measure-assistant-tokens.mjs",
    "lint": "eslint .",
    "assistant:index-map": "node scripts/assistant-index-map.mjs",
    "assistant:eval": "node scripts/assistant-eval.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@supabase/supabase-js": "^2.47.0",
    "@touch/config": "workspace:*",
    "@types/node": "^20.17.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.15.0",
    "qrcode": "^1.5.4",
    "supabase": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
