# Local secrets for `pnpm exec supabase functions serve --env-file supabase/functions/.env`
# Copy to supabase/functions/.env (gitignored). Hosted: `pnpm exec supabase secrets set NAME=value`.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by the platform.

# --- analytics-posthog (all optional; unset => {configured:false}) ---
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com
# YYYY-MM-DD: events before this date are ignored (clips every window); empty = no floor
POSTHOG_ENGAGEMENT_FLOOR=

# --- analytics-insights (all optional; unset => {degraded:true}) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=llama-3.1-8b-instant

# --- telegram-send / telegram-callback (see supabase/functions/SETUP-telegram.md) ---
# Bot token from @BotFather; unset => outbox rows are marked skipped (NOT_CONFIGURED)
TELEGRAM_BOT_TOKEN=
# `openssl rand -hex 32`; must equal the secret_token passed to setWebhook. Unset => callback answers 401
TELEGRAM_WEBHOOK_SECRET=

# --- send-sms-otp (phone OTP, DORMANT scaffold 2026-09-05; docs/client/phone-otp-activation.md) ---
# Standard-Webhooks secret GoTrue signs the hook with: "v1,whsec_<base64>". Unset => the hook answers 401
# to everything. Locally it must equal [auth.hook.send_sms].secrets in config.toml (this value is that
# committed local-only placeholder). Hosted: generated under Auth -> Hooks -> Send SMS, then `secrets set`.
SEND_SMS_HOOK_SECRET=v1,whsec_dG91Y2gtbG9jYWwtZGV2LXNlbmQtc21zLWhvb2stc2VjcmV0LW5vdC1yZWFsISE=
# log | twilio | otpiq | whatsapp. Unset => log (writes the send row, sends nothing, spends nothing). A named vendor
# with missing keys, or an unknown name, fails every send with the reason (never a silent log).
# Owner decision 2026-09-16: otpiq, WhatsApp with SMS fallback, now; whatsapp (Meta Cloud API) once Meta setup is done — stage the WHATSAPP_*
# secrets in advance, then the move is SMS_PROVIDER=whatsapp (runbook §C "Moving to WhatsApp").
# ONE seam: every edge function texts through _shared/sms/index.ts `sendSms()`; swapping the vendor
# is this value plus its keys (a new vendor = one adapter file there, see _shared/sms/types.ts).
SMS_PROVIDER=log
# twilio: TWILIO_FROM is the REGISTERED alphanumeric sender id for Iraq (Asiacell requires
# pre-registration; Zain/Korek drop numeric senders), or "whatsapp:+1..." for the WhatsApp channel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# whatsapp (Meta Cloud API): permanent System User token + the WhatsApp phone number id from WhatsApp Manager.
# The template is an AUTHENTICATION template created once per language (en, ar) under ONE name; the language
# codes must match what WhatsApp Manager shows (e.g. "en_US" vs "en"). Graph version defaults to v26.0.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=touch_otp
WHATSAPP_TEMPLATE_LANG_EN=en
WHATSAPP_TEMPLATE_LANG_AR=ar
WHATSAPP_DEFAULT_LANG=ar
WHATSAPP_GRAPH_VERSION=v26.0
# otpiq: routing string per the vendor docs (sms | auto | whatsapp | telegram | whatsapp-sms | whatsapp-telegram-sms).
# Launch routing (2026-09-16): "whatsapp-sms" — try OTPIQ's own WhatsApp account first, fall back to SMS for a number
# that cannot receive WhatsApp, so no guest is left without a code. ("whatsapp" = WhatsApp only, "sms" = SMS only.)
# The adapter's default when unset is "whatsapp-sms". NOTE: Meta's Cloud API (SMS_PROVIDER=whatsapp) has NO fallback —
# moving to it under Touch's own name gives up the SMS leg unless a chain is built in the seam first.
# OTPIQ_SENDER_ID: leave EMPTY until OTPIQ approves the id — an unapproved id fails every send.
OTPIQ_API_KEY=
OTPIQ_PROVIDER=whatsapp-sms
OTPIQ_SENDER_ID=

# --- apple-revoke (Sign in with Apple token revocation on account deletion; header of apple-revoke/index.ts) ---
# All four unset => the function answers 501 NOT_CONFIGURED and the app deletes the account without revoking.
# APPLE_CLIENT_ID is the native app's bundle id (the audience of the codes expo-apple-authentication returns).
# APPLE_PRIVATE_KEY_P8 = the whole AuthKey_<KEYID>.p8 incl. BEGIN/END lines; literal \n or real newlines both work.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.kagu.touchpadel
APPLE_PRIVATE_KEY_P8=

# --- assistant-chat / assistant-index / assistant-job (owner assistant; docs/design/assistant/build-contracts-2026-09-20.md "Environment") ---
# No ANTHROPIC_API_KEY => assistant-chat answers 503 {code:'NOT_CONFIGURED'} before any database write; the drawer says so.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# voyage | openai | local | none. Unset => none: search is full-text only and the UI says so. A named vendor with a missing key,
# or an unknown name, fails the index run loudly (EmbedError) rather than silently indexing without vectors.
# ONE seam: every embedding goes through _shared/assistant/embed.ts `embed()`; the vendor swap is this value plus its key.
EMBEDDING_PROVIDER=none
VOYAGE_API_KEY=
OPENAI_API_KEY=
