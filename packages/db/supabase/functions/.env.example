# Local secrets for `pnpm exec supabase functions serve --env-file supabase/functions/.env`
# Copy to supabase/functions/.env (gitignored). Hosted: `pnpm exec supabase secrets set NAME=value`.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by the platform.

# --- analytics-posthog (all optional; unset => {configured:false}) ---
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com
# YYYY-MM-DD: events before this date are ignored (clips every window); empty = no floor
POSTHOG_ENGAGEMENT_FLOOR=

# --- analytics-insights (all optional; unset => {degraded:true}) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=llama-3.1-8b-instant

# --- telegram-send / telegram-callback (see supabase/functions/SETUP-telegram.md) ---
# Bot token from @BotFather; unset => outbox rows are marked skipped (NOT_CONFIGURED)
TELEGRAM_BOT_TOKEN=
# `openssl rand -hex 32`; must equal the secret_token passed to setWebhook. Unset => callback answers 401
TELEGRAM_WEBHOOK_SECRET=

# --- send-sms-otp (phone OTP, DORMANT scaffold 2026-09-05; docs/client/phone-otp-activation.md) ---
# Standard-Webhooks secret GoTrue signs the hook with: "v1,whsec_<base64>". Unset => the hook answers 401
# to everything. Locally it must equal [auth.hook.send_sms].secrets in config.toml (this value is that
# committed local-only placeholder). Hosted: generated under Auth -> Hooks -> Send SMS, then `secrets set`.
SEND_SMS_HOOK_SECRET=v1,whsec_dG91Y2gtbG9jYWwtZGV2LXNlbmQtc21zLWhvb2stc2VjcmV0LW5vdC1yZWFsISE=
# log | twilio | otpiq. Unset/unknown => log (writes the send row, sends nothing, spends nothing).
# ONE seam: every edge function texts through _shared/sms/index.ts `sendSms()`; swapping the vendor
# is this value plus its keys (a new vendor = one adapter file there, see _shared/sms/types.ts).
SMS_PROVIDER=log
# twilio: TWILIO_FROM is the REGISTERED alphanumeric sender id for Iraq (Asiacell requires
# pre-registration; Zain/Korek drop numeric senders), or "whatsapp:+1..." for the WhatsApp channel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# otpiq: routing string per the vendor docs (sms | auto | whatsapp | telegram | whatsapp-sms | whatsapp-telegram-sms).
# Owner decision 2026-09-12: SMS only, no WhatsApp — keep "sms" (also the adapter's default when unset).
OTPIQ_API_KEY=
OTPIQ_PROVIDER=sms
OTPIQ_SENDER_ID=
