# Copy to apps/operator/.env.local. Names only — never commit values.
# VITE_* is inlined into the operator bundle; never put a secret behind it.

# Supabase project URL and anon key. Both are required outside dev; dev falls
# back to the local Docker stack when unset.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public guest site origin, used to build the cafe QR codes in Admin → QR.
VITE_GUEST_SITE_URL=

# VITE_APP_VERSION is stamped by the operator-shell build; leave it unset in dev.
