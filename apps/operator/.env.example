# Copy to .env for local dev. `.env` is gitignored — never commit real keys.
#
# Vite only exposes VITE_*-prefixed vars to the renderer, and they are BAKED IN
# at build time: a packaged station carries whatever was set when it was built
# (design-arch.md §7), so a station is re-pointed by rebuilding, not by editing
# a file on the till.

# ── Backend (required) ──────────────────────────────────────────────────────
# Local stack: `supabase start` and copy the URL + anon key it prints.
# Hosted project: the URL + publishable key from Supabase → Project Settings → API.
#
# Under `vite dev` these two may be omitted and the local demo stack is assumed.
# A production build REFUSES to guess and fails at startup instead — a station
# silently pointed at 127.0.0.1 presents as "the network is down", which is the
# most expensive way to be wrong on a till (see src/lib/supabase.ts).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# ── Guest site (optional) ───────────────────────────────────────────────────
# Public origin the table QR codes point at, no trailing slash. Admin → QR
# renders the printable cards from it; without it the QR page has no link to
# encode. Must be the origin guests reach from their phones, not localhost.
VITE_GUEST_SITE_URL=http://localhost:3000

# ── Build stamp (optional) ──────────────────────────────────────────────────
# Sent with every device heartbeat so a station's build is identifiable
# server-side. Defaults to 'dev'; CI should set the real release version.
VITE_APP_VERSION=dev
