{
  "name": "@touch/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "jest --ci",
    "test:smoke:watch": "jest --watch",
    "lint": "eslint .",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "doctor": "npx --yes expo-doctor@latest",
    "icons": "node scripts/make-icons.mjs",
    "store": "node store/render.mjs",
    "store:copy-check": "node store/copy-check.mjs",
    "store:strings-check": "node store/strings-check.mjs",
    "store:chrome-prompt": "node store/chrome-prompt.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ui": "~58.0.25",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.47.0",
    "@tanstack/query-async-storage-persister": "^5.62.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-query-persist-client": "^5.62.0",
    "@touch/core": "workspace:*",
    "@touch/court3d": "workspace:*",
    "@touch/db": "workspace:*",
    "@touch/i18n": "workspace:*",
    "@touch/ui": "workspace:*",
    "expo": "~58.0.21",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-gl": "~58.0.3",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-get-random-values": "~1.11.0",
    "react-native-nitro-google-signin": "2.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@jest/globals": "~30.5.2",
    "@testing-library/react-native": "^13.3.0",
    "@touch/config": "workspace:*",
    "@types/react": "~19.3.0",
    "@types/three": "0.160.0",
    "eslint": "^9.15.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "react-test-renderer": "19.3.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-google-signin",
          "react-native-nitro-modules"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
