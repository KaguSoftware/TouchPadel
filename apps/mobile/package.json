{
  "name": "@touch/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "doctor": "npx --yes expo-doctor@latest"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo-google-fonts/mulish": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.47.0",
    "@tanstack/query-async-storage-persister": "^5.62.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-query-persist-client": "^5.62.0",
    "@touch/core": "workspace:*",
    "@touch/db": "workspace:*",
    "@touch/i18n": "workspace:*",
    "@touch/ui": "workspace:*",
    "expo": "~57.0.20",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "^57.0.3",
    "expo-gl": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-nitro-google-signin": "2.1.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "^15.15.4",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@touch/config": "workspace:*",
    "@types/react": "~19.2.18",
    "@types/three": "0.160.0",
    "eslint": "^9.15.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-google-signin",
          "react-native-nitro-modules"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
