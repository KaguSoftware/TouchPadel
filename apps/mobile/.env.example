# Copy to apps/mobile/.env. Names only — never commit values.
# EXPO_PUBLIC_* is inlined into the app binary; never put a secret behind it.

# Supabase project URL and anon key (anon key is public by design; RLS is the control).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in client ids (format: <digits>-<hash>.apps.googleusercontent.com).
# An EAS build fails at config time if the iOS id is missing or a placeholder.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional. Domain that owns the app's auth links (universal/app links).
# Defaults to touchpadel.invalid until DNS is delegated. Pair with NEXT_PUBLIC_SITE_URL on web.
EXPO_PUBLIC_LINK_DOMAIN=

# Optional. Phone-OTP login feature flag (true/false). Off when unset.
EXPO_PUBLIC_PHONE_OTP=
