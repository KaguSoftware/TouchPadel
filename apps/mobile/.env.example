# Copy to .env for local dev (values from `supabase start` output).
# Staging/production values live in eas.json profile env blocks — never commit real keys.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Social sign-in (vendor addition 2026-09-01). Public identifiers, NOT secrets —
# the Web client id is also the `aud` of Android id tokens; the iOS client id
# yields the URL scheme (derived in app.config.ts). Unset = the Google button is
# hidden (it is hidden in Expo Go regardless: the native SDK needs a dev build).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace-with-ios-client-id.apps.googleusercontent.com
# Only <project-number>-<hash>.apps.googleusercontent.com counts as set; a placeholder like the two
# above is treated as UNSET (button hidden), and an EAS build fails at config time on it.
