# Copy to apps/web/.env.local. Names only — never commit values.
# NEXT_PUBLIC_* is inlined into the browser bundle; never put a secret behind it.

# Supabase project URL (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key (public by design; RLS is the control).
# The newer sb_publishable_* key works too, under NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Public origin of the site, used for metadataBase and the app-link
# association files. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Optional. PostHog project key (write-only ingest id) and host. Analytics is
# off when the key is empty.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
