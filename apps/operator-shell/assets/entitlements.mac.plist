<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the macOS build (electron-builder.config.cjs,
  used for both entitlements and entitlementsInherit). Electron's V8 needs JIT
  and unsigned executable memory; better-sqlite3 is a native module loaded from
  outside the asar, which needs library validation off. This is the set
  electron-builder ships as its own default template, kept in-repo so a future
  entitlement has a home.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
