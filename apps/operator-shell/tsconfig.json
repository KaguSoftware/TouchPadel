{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Electron main + preload compile to CommonJS for require() loading — the
    // monorepo's one sanctioned CJS exception (HANDOFF conventions).
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false, // incompatible with CJS emit; base turns it on
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src"],
  // Tests are typechecked by tsconfig.test.json; keeping them out of the build
  // project stops vitest specs being emitted into the packaged dist/.
  "exclude": ["src/**/*.test.ts"]
}
